{
  "info": {
    "name": "JJ Dashboard and Translation - React Native",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authenticated mobile APIs. Set username/password or token. New code must be deployed on the chosen host. Google translation requires GOOGLE_TRANSLATE_API_KEY on the backend. No web changes."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://krai.ploughmanagro.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "month",
      "value": "August"
    },
    {
      "key": "target_week",
      "value": "all"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login and Filters",
      "item": [
        {
          "name": "JJ Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/jeevika-jankar-login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set(\"token\", data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Month and Week Dropdowns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/jeevika-jankar-dashboard/filters?month={{month}}"
          }
        },
        {
          "name": "Complete JJ Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/jeevika-jankar-dashboard?month={{month}}&target_week={{target_week}}"
          }
        }
      ]
    },
    {
      "name": "Each Dashboard Box",
      "item": [
        {
          "name": "Mapped Villages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/jeevika-jankar-dashboard/widgets/mapped_villages?month={{month}}"
          }
        },
        {
          "name": "Main Major Work Indicators",
          "request": {
            "method": "GET",
