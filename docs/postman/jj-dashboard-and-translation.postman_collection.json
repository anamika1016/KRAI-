    {
      "name": "Translation",
      "item": [
        {
          "name": "Supported Languages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/translate/languages"
          }
        },
        {
          "name": "Translate Screen Labels to Hindi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/translate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": [\n    \"Mapped Villages\",\n    \"Assigned Target\",\n    \"Assigned Farmers\",\n    \"Weekly Target Plan\"\n  ],\n  \"source\": \"en\",\n  \"target\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "English Identity Check - No Google Required",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/translate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": [\n    \"Dashboard\"\n  ],\n  \"source\": \"en\",\n  \"target\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
