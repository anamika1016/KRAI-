{
  "info": {
    "name": "CC FCOC Agronomist \u2014 complete mobile dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Deploy backend first. Set base_url, login and password locally. Run Login, Filters, Complete dashboard. Token is stored automatically. Repeat separately for CC, FCOC and Agronomist. GET requests do not need a JSON body. Tests do not enforce a production latency promise."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://krai.ploughmanagro.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "month",
      "value": "September"
    },
    {
      "key": "main_activity",
      "value": "Farmers' Training"
    },
    {
      "key": "widget_key",
      "value": "summary_ics"
    },
    {
      "key": "list_key",
      "value": "summary_ics"
    },
    {
      "key": "login",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "sub_activity",
      "value": "All"
    },
    {
      "key": "fco",
      "value": "All"
    },
    {
      "key": "ics",
      "value": "All"
    }
  ],
  "item": [
    {
      "name": "01 POST Login \u2014 saves token",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"token\");",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Success\", () => pm.expect(body.success).to.eql(true));",
              "if (pm.response.code === 200 && body.token) pm.collectionVariables.set(\"token\", body.token);"
            ]
          }
        }
      ]
    },
