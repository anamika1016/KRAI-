<% content_for :title, "AFL Upload" %>

<main class="vrp-list-page">
  <section class="vrp-list-shell">
    <div class="vrp-list-header">
      <div>
        <p class="vrp-eyebrow">Target Mapping</p>
        <h1>AFL Upload</h1>
      </div>
    </div>

    <div class="vrp-list-card">
      <div class="list-controls">
        <%= form_with url: import_afls_path, multipart: true, local: true, class: "list-search" do |form| %>
          <span>▤</span>
          <%= form.file_field :file, accept: ".xlsx,.csv", class: "form-control", required: true %>
          <%= form.submit "Upload", class: "list-btn upload" %>
        <% end %>

        <div class="list-control-actions">
          <%= form_with url: afls_path, method: :get, local: true, class: "list-search compact", id: "afl_search_form" do |form| %>
            <span>⌕</span>
            <% Array(params[:fco_id]).each do |fco_id| %>
              <%= hidden_field_tag "fco_id[]", fco_id if fco_id.present? %>
            <% end %>
            <%= hidden_field_tag :fcoc, params[:fcoc] if params[:fcoc].present? %>
            <%= hidden_field_tag :ics, params[:ics] if params[:ics].present? %>
            <%= hidden_field_tag :ics_id, params[:ics_id] if params[:ics_id].present? %>
            <%= hidden_field_tag :summary_mode, params[:summary_mode] if params[:summary_mode].present? %>
            <%= hidden_field_tag :month, params[:month] if params[:month].present? %>
            <%= hidden_field_tag :main_activity, params[:main_activity] if params[:main_activity].present? %>
            <%= hidden_field_tag :sub_activity, params[:sub_activity] if params[:sub_activity].present? %>
            <%= form.search_field :q, value: @query, placeholder: "Search any field", data: { table_search: "afl_list" } %>
          <% end %>
          <%= link_to "Export Excel", afls_path(request.query_parameters.merge(format: :xlsx)), class: "list-btn export" %>
        </div>
      </div>

      <% if params[:report_id].present? %>
        <div class="import-report-banner">
          <span>Skipped rows ka exact reason report ready hai.</span>
          <%= link_to "Download skipped report", import_report_afls_path(params[:report_id]), class: "table-action" %>
        </div>
      <% end %>

      <%# Heading labels paired with the column each one searches. A column
          added here gets its heading filter for free. A nil column is one
          there is nothing to search on -- the row checkbox, and Farmer Count,
          which is a total rather than a stored value. %>
      <%
        afl_columns =
          case @summary_mode
          when "ics"
            [["FCO ID", :fco_id], ["FCO Name", :fco], ["FPO ID", :fpo_id], ["FPO Name", :fpo_name],
             ["ICS ID", :ics_id], ["ICS Name", :ics_name], ["Farmer Count", nil]]
          when "village"
            [["FCO ID", :fco_id], ["FCO Name", :fco], ["FPO ID", :fpo_id], ["FPO Name", :fpo_name],
             ["ICS ID", :ics_id], ["ICS Name", :ics_name], ["Village ID", :village_id],
             ["Village Name", :village_name], ["Farmer Count", nil]]
          when "farmer"
            [["FCO ID", :fco_id], ["FCO Name", :fco], ["FPO ID", :fpo_id], ["FPO Name", :fpo_name],
             ["ICS ID", :ics_id], ["ICS Name", :ics_name], ["Village ID", :village_id],
             ["Village Name", :village_name], ["Tracenet No", :tracenet_no],
             ["Farmer Name", :farmer_name], ["Father Name", :father_name]]
          else
            [[nil, nil], ["ID", :id], ["Farm ID", :farm_id], ["FCO ID", :fco_id], ["FCO", :fco],
             ["FPO ID", :fpo_id], ["FPO Name", :fpo_name], ["ICS ID", :ics_id], ["ICS Name", :ics_name],
             ["Village ID", :village_id], ["Village Name", :village_name], ["Farmer Name", :farmer_name],
             ["Father Name", :father_name], ["Tracenet No", :tracenet_no], ["Total Farm Area", :total_farm_area],
             ["Purchase Quantity Amount", :purchase_quantity_amount], ["Estimate Quantity", :estimate_quantity],
             ["Purchase Quantity", :purchase_quantity], ["Purchase Date", :purchase_date],
             ["Mobile No", :mobile_no], ["Purchase Product", :purchase_product], ["Status", :status]]
          end
      %>
      <div class="table-shell">
        <%# This list is paginated by the server, so its heading filters have to
            go back to the server -- filtering the fifteen rows on screen would
            quietly hide the rest. data-column-filter-form tells the shared
            filter widget to submit instead of filtering in place; the look and
            the Contains/Equals/Starts/Ends choices stay the same as every
            other list. %>
        <table class="module-table vrp-list-table" id="afl_list"
               data-column-filters-enabled
               data-column-filter-form="afl_search_form">
          <thead>
            <tr>
              <% afl_columns.each do |label, column| %>
                <% filter_attributes = column.present? ? {
                     column_filter_param: "col[#{column}]",
                     column_filter_operator_param: "colop[#{column}]",
                     column_filter_value: @column_filters&.dig(column.to_s),
                     column_filter_operator: @column_filter_operators&.dig(column.to_s)
                   } : {} %>
                <%= tag.th data: filter_attributes do %>
                  <% if label.nil? %>
                    <input type="checkbox" data-afl-select-all>
                  <% else %>
                    <%= label %>
                  <% end %>
                <% end %>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% if @afls.any? %>
              <% @afls.each do |afl| %>
                <% if @summary_mode == "ics" %>
                  <tr>
                    <td><%= afl[:fco_id] %></td>
                    <td><%= afl[:fco].presence || "-" %></td>
                    <td><%= afl[:fpo_id] %></td>
                    <td><%= afl[:fpo_name].presence || "-" %></td>
                    <td><%= afl[:ics_id] %></td>
                    <td><%= afl[:ics_name].presence || "-" %></td>
                    <td><%= afl[:farmer_count].to_i %></td>
                  </tr>
                <% elsif @summary_mode == "village" %>
                  <tr>
                    <td><%= afl[:fco_id] %></td>
                    <td><%= afl[:fco].presence || "-" %></td>
                    <td><%= afl[:fpo_id] %></td>
                    <td><%= afl[:fpo_name].presence || "-" %></td>
                    <td><%= afl[:ics_id] %></td>
                    <td><%= afl[:ics_name].presence || "-" %></td>
                    <td><%= afl[:village_id] %></td>
                    <td><%= afl[:village_name].presence || "-" %></td>
                    <td>
                      <%= link_to afl[:farmer_count].to_i,
                            afls_path(request.query_parameters.merge(summary_mode: "farmer", ics_id: afl[:ics_id], village_id: afl[:village_id], page: nil)),
                            class: "table-action" %>
                    </td>
                  </tr>
                <% elsif @summary_mode == "farmer" %>
                  <tr>
                    <td><%= afl[:fco_id] %></td>
                    <td><%= afl[:fco].presence || "-" %></td>
                    <td><%= afl[:fpo_id] %></td>
                    <td><%= afl[:fpo_name].presence || "-" %></td>
                    <td><%= afl[:ics_id] %></td>
                    <td><%= afl[:ics_name].presence || "-" %></td>
                    <td><%= afl[:village_id] %></td>
                    <td><%= afl[:village_name].presence || "-" %></td>
                    <td><%= afl[:tracenet_no] %></td>
                    <td><%= afl[:farmer_name].presence || "-" %></td>
                    <td><%= afl[:father_name].presence || "-" %></td>
                  </tr>
                <% else %>
                  <tr>
                    <td><input type="checkbox" value="<%= afl_path(afl, request.query_parameters.slice("q", "page", "fco_id", "fcoc", "ics", "ics_id")) %>" data-afl-row-select></td>
                    <td><%= afl.id %></td>
                    <td><%= afl.farm_id %></td>
                    <td><%= afl.fco_id %></td>
                    <td><%= afl.fco %></td>
                    <td><%= afl.fpo_id %></td>
                    <td><%= afl.fpo_name %></td>
                    <td><%= afl.ics_id %></td>
                    <td><%= afl.ics_name %></td>
                    <td><%= afl.village_id %></td>
                    <td><%= afl.village_name %></td>
                    <td><%= afl.farmer_name %></td>
                    <td><%= afl.father_name %></td>
                    <td><%= afl.tracenet_no %></td>
                    <td><%= afl.total_farm_area %></td>
                    <td><%= afl.purchase_quantity_amount %></td>
                    <td><%= afl.estimate_quantity %></td>
                    <td><%= afl.purchase_quantity %></td>
                    <td><%= afl.purchase_date&.strftime("%d-%m-%Y") %></td>
                    <td><%= afl.mobile_no %></td>
                    <td><%= afl.purchase_product %></td>
                    <td><%= afl.status %></td>
                  </tr>
                <% end %>
              <% end %>
            <% else %>
              <tr>
                <td colspan="<%= @summary_mode == "ics" ? 7 : (@summary_mode == "village" ? 9 : (@summary_mode == "farmer" ? 11 : 22)) %>">No target mapping records uploaded yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination">
        <% start_count = @total_afls.zero? ? 0 : ((@page - 1) * @page_size) + 1 %>
        <% end_count = [@page * @page_size, @total_afls].min %>
        <span><%= start_count %> to <%= end_count %> of <%= @total_afls %></span>
        <% if @page > 1 %>
          <%= link_to "‹", afls_path(request.query_parameters.merge(page: @page - 1)), class: "page-link" %>
        <% else %>
          <span class="page-link disabled">‹</span>
        <% end %>
        <strong>Page <%= @page %> of <%= @total_pages %></strong>
        <% if @page < @total_pages %>
          <%= link_to "›", afls_path(request.query_parameters.merge(page: @page + 1)), class: "page-link" %>
        <% else %>
          <span class="page-link disabled">›</span>
        <% end %>
      </div>
    </div>
  </section>
</main>
