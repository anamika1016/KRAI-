<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "JJ" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JJ">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Favicon follows the Stakeholder Name logo when configured, else static icons. %>
    <% if (stakeholder_favicon = app_stakeholder_logo).present? %>
      <link rel="icon" href="<%= stakeholder_favicon %>">
      <link rel="apple-touch-icon" href="<%= stakeholder_favicon %>">
    <% else %>
      <link rel="icon" href="/jj_logo.png" type="image/png">
      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/favicon.ico" type="image/x-icon">
      <link rel="apple-touch-icon" href="/jj_logo.png">
    <% end %>

    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if controller_name == "sessions" %>
      <%= yield %>
    <% else %>
      <div class="app-frame">
        <div class="mobile-menu-bar">
          <button type="button" class="mobile-menu-toggle" data-mobile-menu-toggle aria-controls="app-sidebar" aria-expanded="false">
            <span>☰</span>
            <strong>Menu</strong>
          </button>
          <span class="mobile-menu-title"><%= content_for(:title) || "JJ" %></span>
        </div>
        <button type="button" class="mobile-sidebar-backdrop" data-mobile-sidebar-backdrop aria-label="Close menu"></button>
        <%= render "layouts/sidebar" %>

        <div class="app-main">
          <div class="app-language-bar">
            <div class="language-switcher" data-language-switcher>
              <span>Language</span>
              <button type="button" data-language-option="en">English</button>
              <button type="button" data-language-option="hi">हिन्दी</button>
              <button type="button" data-language-option="mr">मराठी</button>
              <button type="button" data-language-option="or">ଓଡ଼ିଆ</button>
              <button type="button" data-language-option="gu">ગુજરાતી</button>
            </div>
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
              <span data-theme-toggle-icon>☾</span>
              <strong data-theme-toggle-label>Dark</strong>
            </button>
            <div id="google_translate_element" class="google-translate-holder" aria-hidden="true"></div>
          </div>

          <% if notice.present? %>
            <div class="app-notice"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="app-alert"><%= alert %></div>
          <% end %>

          <%= yield %>
        </div>
      </div>

      <div class="ai-assistant" data-ai-assistant data-endpoint="<%= assistant_chat_path %>">
        <button type="button" class="ai-assistant-toggle" data-ai-toggle aria-expanded="false" aria-label="Open AI assistant">
          <span class="ai-assistant-toggle-icon" aria-hidden="true">✨</span>
        </button>

        <div class="ai-assistant-panel" data-ai-panel hidden>
          <div class="ai-assistant-header">
            <div class="ai-assistant-title">
              <span class="ai-assistant-title-icon" aria-hidden="true">✨</span>
              <div>
                <strong>AI Assistant</strong>
                <small>Ask about this application</small>
              </div>
            </div>
            <button type="button" class="ai-assistant-close" data-ai-close aria-label="Close">✕</button>
          </div>

          <div class="ai-assistant-messages" data-ai-messages aria-live="polite">
            <div class="ai-assistant-msg ai-assistant-msg--bot">
              Hi! Main is application ka AI assistant hoon. Aap mujhse dashboards, reports, target mapping, training forms — kisi bhi feature ke baare me puch sakte hain.
            </div>
          </div>

          <form class="ai-assistant-form" data-ai-form>
            <textarea data-ai-input class="ai-assistant-input" rows="1" placeholder="Type your question…" autocomplete="off"></textarea>
            <button type="submit" class="ai-assistant-send" data-ai-send aria-label="Send">➤</button>
          </form>
        </div>
      </div>
    <% end %>
  </body>
</html>
